# Google OAuth Web Client ID (see README step 1)
GOOGLE_CLIENT_ID=your-id.apps.googleusercontent.com
# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# Leave EMPTY to let any Gmail account host. Or list allowed Gmail addresses, comma separated.
OWNER_EMAILS=
PORT=3000
MAX_MEMBERS=4
MAX_UPLOAD_MB=2048
# Set to production when served over HTTPS
NODE_ENV=production
